<body>

<header>
  Pembelajaran PJOK: Bola Basket
  <div class="creator">
    Muhammad Asad Fauzan Karunia | 41182191240048
  </div>
</header>

<nav>
  <a href="#materi">Materi</a>
  <a href="#quiz">Kuis</a>
  <a href="#tentang">Tentang Pembuat</a>
</nav>

<main>

  <!-- Materi -->
  <section id="materi">
    <h2>Materi Bola Basket</h2>
    <p>Bola basket adalah olahraga yang menggunakan bola dan dilakukan di lapangan khusus. Tujuannya adalah memasukkan bola ke dalam keranjang lawan untuk mendapatkan poin.</p>
    
    <img src="https://upload.wikimedia.org/wikipedia/commons/7/7a/Basketball.png" alt="Gambar Bola Basket" class="basketball" />
    
    <p><strong>Bagian-bagian Bola Basket:</strong> Permukaannya bertekstur dengan pola garis hitam yang khas agar mudah digenggam dan di-dribble.</p>
    
    <audio controls class="audio-control">
      <source src="https://www.soundhelix.com/examples/mp3/SoundHelix-Song-1.mp3" type="audio/mpeg">
      Browser Anda tidak mendukung elemen audio.
    </audio>
    
    <p><strong>Teknik dasar dalam bola basket:</strong></p>
    <ul>
      <li><strong>Dribbling:</strong> Menggiring bola dengan cara memantulkan bola ke lantai menggunakan satu tangan secara berulang.</li>
      <li><strong>Passing:</strong> Mengoper bola ke teman satu tim.</li>
      <li><strong>Shooting:</strong> Teknik memasukkan bola ke keranjang lawan.</li>
    </ul>
    
    <img src="https://upload.wikimedia.org/wikipedia/commons/d/d5/Basketball_shot.JPG" alt="Teknik Shooting" style="width:100%; max-width:400px; display:block; margin:auto;" />
  </section>

  <!-- Kuis -->
  <section id="quiz">
    <h2>Kuis Bola Basket</h2>
    <div class="quiz-item">
      <div class="quiz-question">1. Apa nama teknik dalam bola basket saat menggiring bola ke arah depan?</div>
      <div class="quiz-options">
        <button onclick="checkAnswer(this, 'c')">a. Shooting</button>
        <button onclick="checkAnswer(this, 'c')">b. Passing</button>
        <button onclick="checkAnswer(this, 'c')">c. Dribbling</button>
        <button onclick="checkAnswer(this, 'c')">d. Rebound</button>
      </div>
      <div class="quiz-result"></div>
    </div>
    <div class="quiz-item" style="margin-top: 2rem;">
      <div class="quiz-question">2. Berapa jumlah pemain di lapangan untuk satu tim bola basket saat pertandingan?</div>
      <div class="quiz-options">
        <button onclick="checkAnswer(this, 'd')">a. 6</button>
        <button onclick="checkAnswer(this, 'd')">b. 4</button>
        <button onclick="checkAnswer(this, 'd')">c. 5</button>
        <button onclick="checkAnswer(this, 'd')">d. 5</button>
      </div>
      <div class="quiz-result"></div>
    </div>
  </section>

  <!-- Tentang Pembuat -->
  <section id="tentang">
    <h2>Tentang Pembuat</h2>
    <p>
      Web pembelajaran ini dibuat oleh:<br />
      <strong>Muhammad Asad Fauzan Karunia</strong><br />
      NIM: 41182191240048
    </p>
  </section>

</main>

<script>
  function checkAnswer(button, correctOption) {
    const quizItem = button.closest('.quiz-item');
    const resultDiv = quizItem.querySelector('.quiz-result');
    const buttons = quizItem.querySelectorAll('button');

    // Tentukan jawaban benar untuk tiap soal berdasarkan tombol yang diklik (dengan nilai benar)
    // Untuk soal pertama benar adalah "c" (Dribbling)
    // Untuk soal kedua, jawaban benar adalah 5 pemain (jawaban yang benar tombol terakhir)
    
    // Buat mapping berdasarkan pertanyaan index
    // Karena cara ini tidak sempurna di contoh sederhana, kita sesuaikan di sini:
    if (quizItem.querySelector('.quiz-question').textContent.trim().startsWith("1.")){
      if (button.textContent.trim().startsWith("c.")) {
        resultDiv.textContent = "Jawaban Anda benar!";
        resultDiv.style.color = "green";
      } else {
        resultDiv.textContent = "Jawaban salah. Jawaban yang benar: c. Dribbling";
        resultDiv.style.color = "red";
      }
    }
    else if (quizItem.querySelector('.quiz-question').textContent.trim().startsWith("2.")) {
      if (button.textContent.trim().endsWith("5")) {
        resultDiv.textContent = "Jawaban Anda benar!";
        resultDiv.style.color = "green";
      } else {
        resultDiv.textContent = "Jawaban salah. Jawaban yang benar: d. 5 pemain";
        resultDiv.style.color = "red";
      }
    }

    // Disable semua buttons setelah klik
    buttons.forEach(btn => btn.disabled = true);
  }
</script>

</body>
